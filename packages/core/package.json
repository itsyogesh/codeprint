{
  "name": "@codeprint/core",
  "version": "0.1.1",
  "description": "Shared document model and PDF renderer for Codeprint.",
  "keywords": [
    "codeprint",
    "pdf",
    "markdown-to-pdf",
    "code-to-pdf",
    "syntax-highlighting",
    "csv-to-pdf",
    "document-rendering"
  ],
  "homepage": "https://codeprint.app/docs",
  "bugs": {
    "url": "https://github.com/itsyogesh/codeprint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyogesh/codeprint.git",
    "directory": "packages/core"
  },
  "author": "Yogesh Kumar",
  "type": "module",
  "files": [
    "dist",
    "assets/fonts/**/OFL.*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight-entry.d.ts",
      "import": "./dist/highlight-entry.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./editorial": {
      "types": "./dist/editorial.d.ts",
      "import": "./dist/editorial.js"
    },
    "./editorial/node": {
      "types": "./dist/editorial-node.d.ts",
      "import": "./dist/editorial-node.js"
    },
    "./editorial/browser": {
      "types": "./dist/editorial-browser.d.ts",
      "import": "./dist/editorial-browser.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.6.0",
    "@resvg/resvg-wasm": "2.6.2",
    "beautiful-mermaid": "1.1.3",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only"
}
