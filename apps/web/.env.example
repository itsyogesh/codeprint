# Keep the CLI and MCP launch surfaces hidden until they are ready to announce.
NEXT_PUBLIC_SHOW_DEVELOPER_TOOLS=false
# Enable only after @codeprint/mcp is published and its clean install is tested.
NEXT_PUBLIC_MCP_RELEASE_AVAILABLE=false

# Public IDs. Optional scripts remain off until a visitor opts in, on codeprint.app only.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Reserved for account provisioning. Replay stays disabled until marketing pages are isolated from editors.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Turn off GA4 Enhanced Measurement for this stream: Codeprint sends sanitized pageviews.
GOOGLE_SITE_VERIFICATION=
# Experimental browser tools. No effect in browsers without native WebMCP support.
NEXT_PUBLIC_ENABLE_WEBMCP=false
